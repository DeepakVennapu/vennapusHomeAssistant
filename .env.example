# Home Assistant
HA_BASE_URL=http://localhost:8123
HA_TOKEN=your_long_lived_access_token_here

# Mosquitto MQTT broker — used by ring-mqtt and HA mqtt integration
MQTT_PASSWORD=your_mosquitto_password_here
mosquito_password=your_mosquitto_password_here

# Gemini (used by ha_claude custom component)
GEMINI_API_KEY=your_gemini_api_key_here

# Tesla (tesla_custom integration — Fleet API credentials)
TESLA_CLIENT_ID=your_tesla_fleet_client_id
TESLA_CLIENT_SECRET=your_tesla_fleet_client_secret
TESLA_BACKUP_CODES=your_tesla_backup_codes
